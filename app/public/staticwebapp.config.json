{
  "trailingSlash": "auto",
  "auth": {
    "identityProviders": {
      "customOpenIdConnectProviders": {
        "ebrostay": {
          "registration": {
            "clientIdSettingName": "EBROSTAY_OIDC_CLIENT_ID",
            "clientCredential": {
              "clientSecretSettingName": "EBROSTAY_OIDC_CLIENT_SECRET"
            },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://ebrostay.ciamlogin.com/172e1505-039e-4565-87e9-4fad91983d51/v2.0/.well-known/openid-configuration"
            }
          },
          "login": {
            "nameClaimType": "name",
            "scopes": [
              "openid",
              "profile",
              "email"
            ],
            "loginParameterNames": []
          }
        },
        "ebrostay-msa": {
          "registration": {
            "clientIdSettingName": "EBROSTAY_MSA_OIDC_CLIENT_ID",
            "clientCredential": {
              "clientSecretSettingName": "EBROSTAY_MSA_OIDC_CLIENT_SECRET"
            },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://login.microsoftonline.com/consumers/v2.0/.well-known/openid-configuration"
            }
          },
          "login": {
            "nameClaimType": "name",
            "scopes": [
              "openid",
              "profile",
              "email"
            ],
            "loginParameterNames": []
          }
        }
      }
    }
  },
  "routes": [
    {
      "route": "/",
      "rewrite": "/index.html"
    },
    {
      "route": "/_next/static/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/brand/*",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/favicon.ico",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    {
      "route": "/es/account",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/en/account",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/es/account/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/en/account/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/es/admin",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/en/admin",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/es/admin/*",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/en/admin/*",
      "allowedRoles": [
        "admin"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/es/sign-in/"
    },
    "404": {
      "rewrite": "/404.html"
    }
  },
  "platform": {
    "apiRuntime": "dotnet-isolated:9.0"
  }
}
