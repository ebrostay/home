{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "app"],
      "port": 3000
    },
    {
      "name": "app-dev-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "app", "--", "-p", "3020"],
      "port": 3020
    },
    {
      "name": "swa",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "swa",
        "start",
        "http://localhost:3000",
        "--api-devserver-url",
        "http://localhost:7071"
      ],
      "port": 4280
    },
    {
      "name": "swa-export",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["swa", "start", "app/out", "--port", "4281"],
      "port": 4281
    }
  ]
}
